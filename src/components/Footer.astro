---
import cv from '../data/cv.json';
const { basics } = cv;
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 py-8 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-xs text-slate-500 dark:text-slate-400">
      © {currentYear} {basics.name}. Built with <a href="https://astro.build" target="_blank" rel="noreferrer" class="underline hover:text-blue-600">Astro</a> & <a href="https://tailwindcss.com" target="_blank" rel="noreferrer" class="underline hover:text-blue-600">Tailwind CSS</a>.
    </p>
    <div class="flex items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
      {basics.profiles.map((profile) => (
        <a
          href={profile.url}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-slate-900 dark:hover:text-white transition-colors"
        >
          {profile.network}
        </a>
      ))}
    </div>
  </div>
</footer>
