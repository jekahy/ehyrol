---
import cv from '../data/cv.json';
const { languages } = cv;
---

<section id="languages" class="py-10 border-b border-slate-200 dark:border-slate-800 scroll-mt-20">
  <div class="space-y-1 mb-6">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
      <span class="w-2.5 h-6 bg-blue-600 rounded-sm inline-block"></span>
      Languages
    </h2>
    <p class="text-sm text-slate-500 dark:text-slate-400">
      Spoken languages & international communication capabilities.
    </p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    {languages.map((lang) => (
      <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-center card-print">
        <h3 class="text-base font-bold text-slate-900 dark:text-white">
          {lang.name}
        </h3>
        <p class="text-xs font-semibold text-blue-600 dark:text-blue-400 mt-1">
          {lang.level}
        </p>
      </div>
    ))}
  </div>
</section>
