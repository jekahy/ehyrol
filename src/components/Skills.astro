---
import cv from '../data/cv.json';
const { skills } = cv;

function getCategoryTrack(categoryName: string): 'manager' | 'architect' {
  const lower = categoryName.toLowerCase();
  if (lower.includes('leadership') || lower.includes('testing') || lower.includes('devops')) {
    return 'manager';
  }
  return 'architect';
}
---

<section id="skills" class="py-10 border-b border-slate-200 dark:border-slate-800 scroll-mt-20">
  <div class="space-y-1 mb-8">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
      <span class="w-2.5 h-6 bg-gradient-to-b from-blue-500 to-indigo-600 rounded-sm inline-block shadow-sm shadow-blue-500/50"></span>
      Skills & Technical Domains
    </h2>
    <p class="text-sm text-slate-600 dark:text-slate-400">
      Core technologies, mobile systems architecture, leadership methodologies, and security standards.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {skills.map((category) => {
      const track = getCategoryTrack(category.category);
      return (
        <div
          data-skill-card={track}
          class="glass-card p-6 card-print transition-all duration-300"
        >
          <div class="flex items-center justify-between gap-2 mb-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-600 dark:bg-blue-500"></span>
              {category.category}
            </h3>
            <span
              data-skill-focus-badge={track}
              class="no-print hidden px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-600/10 text-blue-600 dark:bg-blue-500/20 dark:text-blue-300 border border-blue-500/30"
            >
              Primary Focus
            </span>
          </div>
          <div class="flex flex-wrap gap-2">
            {category.items.map((skill) => (
              <span data-skill-chip={track} class="tech-badge">
                {skill}
              </span>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>
