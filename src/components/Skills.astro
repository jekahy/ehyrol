---
import cv from '../data/cv.json';
const { skills } = cv;
---

<section id="skills" class="py-10 border-b border-slate-200 dark:border-slate-800 scroll-mt-20">
  <div class="space-y-1 mb-8">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
      <span class="w-2.5 h-6 bg-blue-600 rounded-sm inline-block"></span>
      Skills & Expertise
    </h2>
    <p class="text-sm text-slate-500 dark:text-slate-400">
      Core technologies, mobile development stack, and design paradigms.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {skills.map((category) => (
      <div class="p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 card-print">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-3">
          {category.category}
        </h3>
        <div class="flex flex-wrap gap-2">
          {category.items.map((skill) => (
            <span class="px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200/60 dark:border-slate-700/60">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
