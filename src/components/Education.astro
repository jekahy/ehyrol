---
import cv from '../data/cv.json';
const { education } = cv;
---

<section id="education" class="py-10 border-b border-slate-200 dark:border-slate-800 scroll-mt-20">
  <div class="space-y-1 mb-8">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
      <span class="w-2.5 h-6 bg-blue-600 rounded-sm inline-block"></span>
      Education
    </h2>
    <p class="text-sm text-slate-500 dark:text-slate-400">
      Academic background and foundational studies.
    </p>
  </div>

  <div class="space-y-6">
    {education.map((edu) => (
      <div class="p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 card-print">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-2">
          <h3 class="text-base font-bold text-slate-900 dark:text-white">
            {edu.area}
          </h3>
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 w-fit">
            {edu.startDate} — {edu.endDate}
          </span>
        </div>
        <p class="text-sm font-medium text-blue-600 dark:text-blue-400 mb-2">
          {edu.studyType} · {edu.institution}
        </p>
        <p class="text-sm text-slate-600 dark:text-slate-300">
          {edu.description}
        </p>
      </div>
    ))}
  </div>
</section>
