---
import cv from '../data/cv.json';
const { work } = cv;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

function classifyBullet(text: string): 'manager' | 'architect' {
  const lower = text.toLowerCase();
  if (
    lower.includes('squad') ||
    lower.includes('leading') ||
    lower.includes('led a team') ||
    lower.includes('steered team') ||
    lower.includes('interview') ||
    lower.includes('promotion') ||
    lower.includes('mentor') ||
    lower.includes('bootcamp') ||
    lower.includes('root cause analysis') ||
    lower.includes('regression escapes')
  ) {
    return 'manager';
  }
  return 'architect';
}

function classifyTech(tech: string): 'manager' | 'architect' {
  const lower = tech.toLowerCase();
  if (
    lower.includes('scrum') ||
    lower.includes('devops') ||
    lower.includes('e2e') ||
    lower.includes('jenkins') ||
    lower.includes('bitbucket') ||
    lower.includes('git') ||
    lower.includes('ai integration')
  ) {
    return 'manager';
  }
  return 'architect';
}
---

<section id="experience" class="py-10 border-b border-slate-200 dark:border-slate-800 scroll-mt-20">
  <div class="space-y-1 mb-8">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
      <span class="w-2.5 h-6 bg-gradient-to-b from-blue-500 to-indigo-600 rounded-sm inline-block shadow-sm shadow-blue-500/50"></span>
      Engineering Leadership & Experience
    </h2>
    <p class="text-sm text-slate-600 dark:text-slate-400">
      9+ years of cross-functional team leadership, mobile banking systems, security compliance, and architecture.
    </p>
  </div>

  <div class="relative pl-6 border-l-2 border-slate-200 dark:border-slate-800/80 space-y-12">
    {work.map((job) => (
      <div class="relative group card-print">
        <!-- Glowing Timeline Marker -->
        <div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-white dark:bg-slate-950 border-2 border-blue-600 dark:border-blue-500 group-hover:border-blue-500 dark:group-hover:border-blue-400 group-hover:scale-125 group-hover:shadow-[0_0_12px_rgba(59,130,246,0.8)] transition-all"></div>

        <div class="space-y-4">
          <!-- Position & Company Header -->
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {job.position}
              </h3>
              <span class="inline-block text-xs font-semibold px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-800/50 w-fit">
                {job.startDate} — {job.endDate}
              </span>
            </div>
            <p class="text-sm font-semibold text-slate-700 dark:text-slate-300 mt-0.5">
              {job.company} <span class="text-slate-500 font-normal">· {job.location}</span>
            </p>
          </div>

          <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
            {job.summary}
          </p>

          <!-- Nested Sub-Projects (e.g. Banking E-Commerce, AI Assistant) -->
          {job.subProjects && (
            <div class="space-y-4 pt-2">
              {job.subProjects.map((sub) => (
                <div class="p-4 rounded-xl bg-white/90 dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800/80 shadow-sm space-y-2.5 hover:border-blue-400/60 dark:hover:border-slate-700 transition-colors">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                    <h4 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-blue-600 dark:bg-blue-500"></span>
                      {sub.name}
                    </h4>
                    <span class="text-xs font-semibold text-blue-600 dark:text-blue-400">
                      {sub.role}
                    </span>
                  </div>

                  <ul class="space-y-2 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                    {sub.points.map((pt) => {
                      const bTrack = classifyBullet(pt);
                      return (
                        <li
                          data-exp-bullet={bTrack}
                          class="flex items-start gap-2.5 leading-relaxed transition-colors duration-200"
                        >
                          <span data-exp-arrow={bTrack} class="text-blue-600 dark:text-blue-500 shrink-0 mt-0.5 transition-colors">▹</span>
                          <span>{pt}</span>
                        </li>
                      );
                    })}
                  </ul>

                  <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-100 dark:border-slate-800/50">
                    <div class="flex flex-wrap gap-1">
                      {sub.technologies.map((tech) => (
                        <span data-exp-tech={classifyTech(tech)} class="tech-badge">
                          {tech}
                        </span>
                      ))}
                    </div>

                    {sub.caseStudyId && (
                      <a
                        href={`${baseUrl}/challenges#${sub.caseStudyId}`}
                        class="no-print inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-blue-50 dark:bg-blue-950/70 border border-blue-200 dark:border-blue-800/70 text-xs font-bold text-blue-600 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/70 transition-all shadow-sm"
                      >
                        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                        Read behind-the-scenes case study &rarr;
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}

          <!-- Quantified Impact Highlights (Prefer job.points over legacy job.highlights) -->
          {((job as any).points || job.highlights) && ((job as any).points || job.highlights).length > 0 && (
            <ul class="space-y-2 text-sm text-slate-700 dark:text-slate-300">
              {((job as any).points || job.highlights).map((point: string) => {
                const bTrack = classifyBullet(point);
                return (
                  <li
                    data-exp-bullet={bTrack}
                    class="flex items-start gap-2.5 leading-relaxed transition-colors duration-200"
                  >
                    <span data-exp-arrow={bTrack} class="text-blue-600 dark:text-blue-500 shrink-0 mt-0.5 transition-colors">▹</span>
                    <span>{point}</span>
                  </li>
                );
              })}
            </ul>
          )}

          <!-- Tech stack tags -->
          {job.technologies && job.technologies.length > 0 && (
            <div class="flex flex-wrap gap-1.5 pt-1">
              {job.technologies.map((tech) => (
                <span data-exp-tech={classifyTech(tech)} class="tech-badge">
                  {tech}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
