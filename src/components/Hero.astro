---
import cv from '../data/cv.json';
const { basics } = cv;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const photoUrl = `${baseUrl}/profile.jpg`;

const tracks = {
  manager: {
    badge: "Engineering Management · Tech Lead · Delivery Leadership",
    label: "Software Engineering Manager & Mobile Tech Lead",
    summary: "Engineering Manager and Mobile Tech Lead steering cross-functional squads (iOS, Android, Backend, QA) across tier-1 fintech and retail AI platforms. Focused on predictable delivery, blameless Root Cause Analysis, and growing high-performing engineering teams.",
    metrics: [
      { value: "15 FTE", label: "Cross-Squad Lead" },
      { value: "Millions", label: "Active Users" },
      { value: "30+", label: "Tech Interviews" },
      { value: "5 Teams", label: "Program Sync" }
    ]
  },
  architect: {
    badge: "Mobile Systems Architecture · Senior iOS · Security & Scale",
    label: "Mobile Systems Architect & Senior iOS Engineer",
    summary: "Mobile Systems Architect and Senior iOS Engineer designing modular SwiftUI/UIKit architectures, reactive data flows, and embedded React Native modules. Specialized in OWASP MSTG security hardening, 3D Secure biometric auth, and automated verification pipelines.",
    metrics: [
      { value: "9+ Yrs", label: "iOS & Swift" },
      { value: "Millions", label: "App Scale" },
      { value: "40+", label: "Security Fixes" },
      { value: "3DS 2.0", label: "Biometric Auth" }
    ]
  }
};
---

<section id="overview" class="pb-10 border-b border-slate-200 dark:border-slate-800 scroll-mt-24">
  <!-- Interactive 2-Career-Path Switcher Bar -->
  <div class="mb-7 no-print">
    <div class="inline-flex flex-col sm:flex-row sm:items-center gap-2 p-1.5 rounded-2xl bg-slate-200/70 dark:bg-slate-900/90 border border-slate-300/70 dark:border-slate-800 w-full sm:w-auto">
      <span class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Career Focus:
      </span>
      <div class="grid grid-cols-2 gap-1.5 w-full sm:w-auto" role="tablist" aria-label="Career Path Switcher">
        <button
          type="button"
          id="track-btn-manager"
          data-track-btn="manager"
          role="tab"
          aria-selected="true"
          class="track-switch-btn flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-600/25"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Engineering Manager</span>
        </button>

        <button
          type="button"
          id="track-btn-architect"
          data-track-btn="architect"
          role="tab"
          aria-selected="false"
          class="track-switch-btn flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <span>Mobile Architect / Sr. iOS</span>
        </button>
      </div>
    </div>
  </div>

  <div class="flex flex-col-reverse md:flex-row items-start md:items-center justify-between gap-8">
    <div class="space-y-5 max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-300/80 dark:bg-emerald-950/80 dark:text-emerald-300 dark:border-emerald-500/30">
        <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
        <span id="hero-status-badge">
          Based in {basics.location.city}, {basics.location.country} · {tracks.manager.badge}
        </span>
      </div>

      <div>
        <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
          {basics.name}
        </h1>
        <p id="hero-role-label" class="text-lg sm:text-xl font-bold text-blue-600 dark:text-blue-400 mt-1">
          {tracks.manager.label}
        </p>
      </div>

      <p id="hero-summary" class="text-slate-600 dark:text-slate-300 leading-relaxed text-base">
        {tracks.manager.summary}
      </p>

      <!-- Lightweight Inline Metrics Strip (No heavy boxes) -->
      <div id="hero-metrics-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-3 border-y border-slate-200/80 dark:border-slate-800/80 no-print">
        {tracks.manager.metrics.map((metric, idx) => (
          <div>
            <div data-metric-value={idx} class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 dark:text-white">
              {metric.value}
            </div>
            <div data-metric-label={idx} class="text-xs font-medium text-slate-500 dark:text-slate-400">
              {metric.label}
            </div>
          </div>
        ))}
      </div>

      <!-- Single Consolidated Action & Social Row -->
      <div class="flex flex-wrap items-center gap-3 pt-1 no-print">
        <a
          href={`${baseUrl}/challenges`}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-sm shadow-lg shadow-blue-600/25 transition-all hover:scale-[1.02]"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Challenges & Mindset &rarr;
        </a>

        <a
          href="https://www.linkedin.com/in/eugene-hyrol/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-900 font-semibold text-xs sm:text-sm shadow-sm transition-all"
        >
          <svg class="w-4 h-4 text-blue-400 dark:text-blue-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          Connect on LinkedIn
        </a>

        <a
          href="https://github.com/jekahy"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-2.5 text-xs sm:text-sm font-semibold rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-800 hover:border-blue-500 dark:hover:border-blue-400 transition-all"
        >
          <svg class="w-4 h-4 text-slate-700 dark:text-slate-300" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          GitHub
        </a>
      </div>
    </div>

    <!-- Profile Photo / Avatar with Refined Architectural Fallback -->
    <div class="flex-shrink-0">
      <div class="relative group">
        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-blue-600/30 via-indigo-500/20 to-purple-600/30 blur-md opacity-60 group-hover:opacity-90 transition duration-300"></div>
        <div class="relative w-24 h-24 sm:w-28 sm:h-28 rounded-2xl overflow-hidden bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 flex items-center justify-center shadow-lg">
          <img
            src={photoUrl}
            alt={basics.name}
            class="w-full h-full object-cover object-center"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <div style="display:none" class="w-full h-full flex-col items-center justify-center select-none bg-gradient-to-br from-slate-50 via-white to-blue-50/50 dark:from-slate-900 dark:via-slate-900 dark:to-blue-950/40">
            <span class="text-2xl sm:text-3xl font-black tracking-tight bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400 bg-clip-text text-transparent">
              EH
            </span>
            <span class="text-[9px] font-mono font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mt-0.5">
              EM · iOS
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ tracks, city: basics.location.city, country: basics.location.country }}>
  function setCareerTrack(trackKey, updateUrl = true) {
    const data = tracks[trackKey] || tracks.manager;
    const activeClasses = ['bg-gradient-to-r', 'from-blue-600', 'to-indigo-600', 'text-white', 'shadow-md', 'shadow-blue-600/25'];
    const inactiveClasses = ['text-slate-600', 'dark:text-slate-400', 'hover:text-slate-900', 'dark:hover:text-white'];

    document.querySelectorAll('[data-track-btn]').forEach((btn) => {
      const isSelected = btn.getAttribute('data-track-btn') === trackKey;
      btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
      if (isSelected) {
        btn.classList.remove(...inactiveClasses);
        btn.classList.add(...activeClasses);
      } else {
        btn.classList.remove(...activeClasses);
        btn.classList.add(...inactiveClasses);
      }
    });

    const roleLabel = document.getElementById('hero-role-label');
    const summary = document.getElementById('hero-summary');
    const badge = document.getElementById('hero-status-badge');

    if (roleLabel) roleLabel.textContent = data.label;
    if (summary) summary.textContent = data.summary;
    if (badge) badge.textContent = `Based in ${city}, ${country} · ${data.badge}`;

    data.metrics.forEach((m, idx) => {
      const valEl = document.querySelector(`[data-metric-value="${idx}"]`);
      const lblEl = document.querySelector(`[data-metric-label="${idx}"]`);
      if (valEl) valEl.textContent = m.value;
      if (lblEl) lblEl.textContent = m.label;
    });

    document.documentElement.setAttribute('data-career-track', trackKey);

    // Subtly emphasize matching Experience bullets & tech chips without zebra-striping
    document.querySelectorAll('[data-exp-bullet]').forEach((el) => {
      const isMatch = el.getAttribute('data-exp-bullet') === trackKey;
      const arrow = el.querySelector('[data-exp-arrow]');
      if (isMatch) {
        el.classList.add('text-slate-900', 'dark:text-slate-100');
        el.classList.remove('text-slate-600', 'dark:text-slate-400');
        if (arrow) {
          arrow.classList.add('text-blue-600', 'dark:text-blue-400', 'font-bold');
          arrow.classList.remove('text-slate-400', 'dark:text-slate-600');
        }
      } else {
        el.classList.remove('text-slate-900', 'dark:text-slate-100');
        el.classList.add('text-slate-600', 'dark:text-slate-400');
        if (arrow) {
          arrow.classList.remove('text-blue-600', 'dark:text-blue-400', 'font-bold');
          arrow.classList.add('text-slate-400', 'dark:text-slate-600');
        }
      }
    });

    document.querySelectorAll('[data-exp-tech]').forEach((el) => {
      const isMatch = el.getAttribute('data-exp-tech') === trackKey;
      if (isMatch) {
        el.classList.add('border-blue-500/60', 'dark:border-blue-400/60', 'text-blue-700', 'dark:text-blue-300');
      } else {
        el.classList.remove('border-blue-500/60', 'dark:border-blue-400/60', 'text-blue-700', 'dark:text-blue-300');
      }
    });

    // Reorder and highlight matching Skill category cards
    document.querySelectorAll('[data-skill-card]').forEach((card) => {
      const isMatch = card.getAttribute('data-skill-card') === trackKey;
      if (isMatch) {
        card.classList.add('order-first', 'ring-1', 'ring-blue-500/40');
      } else {
        card.classList.remove('order-first', 'ring-1', 'ring-blue-500/40');
      }
    });

    document.querySelectorAll('[data-skill-focus-badge]').forEach((badge) => {
      const isMatch = badge.getAttribute('data-skill-focus-badge') === trackKey;
      if (isMatch) {
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    });

    try {
      localStorage.setItem('careerTrack', trackKey);
      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set('track', trackKey);
        window.history.replaceState({}, '', url);
      }
    } catch (e) {}
  }

  // Initialize from ?track=manager|architect or localStorage
  const params = new URLSearchParams(window.location.search);
  const urlTrack = params.get('track');
  const savedTrack = typeof localStorage !== 'undefined' ? localStorage.getItem('careerTrack') : null;
  const initialTrack = (urlTrack === 'architect' || urlTrack === 'ios')
    ? 'architect'
    : (urlTrack === 'manager' || urlTrack === 'em')
      ? 'manager'
      : (savedTrack === 'architect' ? 'architect' : 'manager');

  setCareerTrack(initialTrack, false);

  document.querySelectorAll('[data-track-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-track-btn');
      setCareerTrack(key, true);
    });
  });
</script>
