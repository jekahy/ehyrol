---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Languages from '../components/Languages.astro';
import Contact from '../components/Contact.astro';
import cv from '../data/cv.json';

const title = `${cv.basics.name} | ${cv.basics.label}`;
---

<BaseLayout title={title} description={cv.basics.summary}>
  <Hero />
  <Experience />
  <Projects limit={2} showViewAll={true} />
  <Skills />
  <Education />
  <Languages />
  <Contact />

  {cv.gdpr && (
    <div class="pt-8 pb-4 text-[11px] text-slate-400 dark:text-slate-500 leading-normal border-t border-slate-200/60 dark:border-slate-800/60 mt-8 card-print">
      <p class="italic">{cv.gdpr}</p>
    </div>
  )}
</BaseLayout>
