---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Leadership from '../components/Leadership.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Languages from '../components/Languages.astro';
import Contact from '../components/Contact.astro';
import SectionSpy from '../components/SectionSpy.astro';
import cv from '../data/cv.json';

const title = `${cv.basics.name} | ${cv.basics.label}`;
---

<BaseLayout title={title} description={cv.basics.summary}>
  <SectionSpy />
  <Hero />
  <Experience />
  <Leadership />
  <Projects limit={4} showViewAll={true} />
  <Skills />
  <Education />
  <Languages />
  <Contact />

  {cv.gdpr && (
    <div class="hidden print:block pt-6 pb-2 text-[10px] text-slate-500 leading-normal border-t border-slate-200 mt-6">
      <p class="italic">{cv.gdpr}</p>
    </div>
  )}
</BaseLayout>
