---
import BaseLayout from '../layouts/BaseLayout.astro';
import Projects from '../components/Projects.astro';
import cv from '../data/cv.json';

const title = `Projects | ${cv.basics.name}`;
const description = "Comprehensive list of open-source projects, iOS applications, and software tools by Eugene Hyrol.";
---

<BaseLayout title={title} description={description}>
  <div class="space-y-6">
    <!-- Breadcrumb / Back Link -->
    <div>
      <a href="/" class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to CV Overview
      </a>
    </div>

    <!-- Page Header -->
    <div class="pb-6 border-b border-slate-200 dark:border-slate-800">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Projects & Open Source
      </h1>
      <p class="text-slate-600 dark:text-slate-300 mt-2 text-base">
        A catalog of native mobile applications, developer libraries, audio utilities, and web experiments.
      </p>
    </div>

    <!-- Full Projects Grid -->
    <Projects showViewAll={false} />

    <!-- Open Source Note -->
    <div class="p-6 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-center space-y-3">
      <h3 class="text-base font-semibold text-slate-900 dark:text-white">
        Looking for more code?
      </h3>
      <p class="text-sm text-slate-600 dark:text-slate-400 max-w-lg mx-auto">
        Explore additional experiments, commits, and public gists directly on GitHub.
      </p>
      <a
        href="https://github.com/jekahy"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-sm transition-all"
      >
        Visit @jekahy on GitHub &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
